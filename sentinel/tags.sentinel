import "tfplan/v2" as tfplan

main = rule {
  all tfplan.resource_changes as _, rc {
    (
      rc.type != "aws_instance" and
      rc.type != "aws_s3_bucket" and
      rc.type != "aws_security_group")or (
      "Environment" in keys(rc.change.after.tags) and
      "Owner" in keys(rc.change.after.tags) and
      "AssignmentName" in keys(rc.change.after.tags) and
      rc.change.after.tags["Environment"] is not "" and
      rc.change.after.tags["Owner"] is not "" and
      rc.change.after.tags["AssignmentName"] is not "")
  }
}